#cloud-config
users:
  - name: vagrant
    groups: [adm,cdrom,sudo,dip,plugdev,users]
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash

write_files:
  - path: /etc/wsl.conf
    content: |
      [boot]
      systemd=false
      command=bash -c '\
        mkdir -p /mnt/wsl/sv-kubernetes && \
        mount --bind /root/sv-kubernetes /mnt/wsl/sv-kubernetes \
      '
      [user]
      default=root
